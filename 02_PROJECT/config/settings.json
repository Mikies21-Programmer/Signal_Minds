{
  "app": {
    "name": "INDIVISA_INGENIUM_2026",
    "version": "0.1.0",
    "environment": "development",
    "description": "Sistema Mecatrónico y Visión Artificial para Retroalimentación de LSM en Tiempo Real",
    "debug": true
  },
  "camera": {
    "stream_url": "http://192.168.4.1/stream",
    "resolution": [320, 240],
    "target_fps": 20,
    "timeout_sec": 1.0,
    "mock_mode": true
  },
  "sensors": {
    "sampling_rate_hz": 50,
    "bus_type": "I2C",
    "bus_id": 1,
    "device_address": "0x68",
    "timeout_ms": 20,
    "mock_mode": true
  },
  "vision": {
    "min_detection_confidence": 0.6,
    "min_tracking_confidence": 0.5,
    "max_num_hands": 1,
    "model_complexity": 1,
    "mock_mode": true
  },
  "lsm": {
    "active_level": 1,
    "default_target_sign": "A",
    "level_1_signs": ["A", "B", "C", "L", "Y"],
    "level_2_signs": ["J", "Ñ", "Q", "X", "Z"],
    "level_3_phrases": ["HOLA", "GRACIAS", "POR FAVOR", "AYUDA", "MAMÁ"],
    "confidence_threshold": 0.80,
    "stability_frames_required": 10
  },
  "api": {
    "host": "0.0.0.0",
    "port": 8000,
    "ws_endpoint": "/ws/telemetry",
    "cors_origins": ["*"]
  },
  "logging": {
    "level": "INFO",
    "log_to_console": true,
    "log_to_file": true,
    "file_path": "logs/indivisa.log",
    "max_bytes": 10485760,
    "backup_count": 3
  }
}
